# --- Réception des demandes (SMTP) ---
# Gmail : SMTP_HOST=smtp.gmail.com / PORT=465 / USER=adresse@gmail.com
#         SMTP_PASSWORD = "mot de passe d'application" (pas le mdp du compte)
# OVH   : SMTP_HOST=ssl0.ovh.net / PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Adresse qui reçoit les demandes (plusieurs séparées par une virgule)
LEADS_NOTIFY_TO=contact@transakautoclermontferrand.com
# Expéditeur affiché (doit être autorisé par le SMTP)
LEADS_NOTIFY_FROM=contact@transakautoclermontferrand.com

# Accusé de réception envoyé au client (true/false)
LEADS_SEND_CONFIRMATION=true

# URL publique du site (sitemap, liens dans les emails)
NEXT_PUBLIC_SITE_URL=https://transakautoclermontferrand.com

# Bloque l'indexation Google (à laisser à true tant que le domaine définitif
# n'est pas en ligne)
NEXT_PUBLIC_NOINDEX=true

# --- Google Ads (facultatif) ---
# Identifiant du compte (AW-xxxxxxxxx) et libellé de l'action de conversion
# « Demande envoyée ». Vides = aucune balise chargée, aucun cookie déposé.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADS_CONVERSION_LABEL=

# --- Supabase (tableau des leads) ---
# URL du projet et clé publique "anon" (visibles côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète "service_role" : utilisée uniquement côté serveur pour enregistrer
# les leads. NE JAMAIS committer, à mettre dans Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Alerte WhatsApp (API officielle Meta Cloud) ---
# Vides = aucune alerte envoyée (email + base restent le canal principal).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=nouveau_lead
WHATSAPP_TEMPLATE_LANG=fr
# Numéros destinataires au format international, séparés par des virgules
# (ex : 33612345678,33698765432)
WHATSAPP_RECIPIENTS=

# --- Plaquette PDF (tableau → Plaquette PDF, et `npm run plaquette`) ---
# Compte mytransak utilisé pour lire les fiches mandat (bouton « Se connecter
# avec Seenaps »). Sans ces valeurs, la version rapide est indisponible.
MYTRANSAK_EMAIL=
MYTRANSAK_PASSWORD=
# Clé API Anthropic, facultative : l'agence n'en utilise pas, la rédaction est
# faite par Claude Code sur le Mac de l'agence (voir ci-dessous).
# ANTHROPIC_API_KEY=
# PLAQUETTE_MODEL=claude-opus-5-5

# --- Service « plaquettes » du Mac de l'agence (scripts/plaquette-worker.mts) ---
# Jeton partagé entre Vercel et le Mac : le service s'en sert pour réclamer les
# demandes et déposer les PDF. Même valeur des deux côtés (openssl rand -hex 24).
PLAQUETTE_WORKER_TOKEN=
# Site interrogé par le service (défaut : https://leads.transakautoclermontferrand.com).
# PLAQUETTE_SITE_URL=
# Binaire Claude Code si le service ne le trouve pas tout seul (CLI ou extension VS Code).
# CLAUDE_BIN=
# Modèle demandé à Claude Code (facultatif, sinon celui par défaut de l'abonnement).
# PLAQUETTE_CLAUDE_MODEL=
